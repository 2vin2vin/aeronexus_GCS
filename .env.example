# Environment configuration template for DroneIQ Ground Control Station Backend

# Active Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# PORT is automatically injected by Render, Railway, Fly.io, etc.
# PORT=10000

# PostgreSQL Database Configuration
# Option A: Discrete parameters (Default / Local / Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=droneiq
DB_USER=droneiq
DB_PASSWORD=droneiq_password

# Option B: Cloud unified connection string (Render, Railway, Supabase, Heroku)
# DATABASE_URL=postgres://user:password@hostname:5432/droneiq_db

# Apache Kafka / Amazon MSK Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=drone.telemetry
KAFKA_CONSUMER_GROUP=droneiq-telemetry-service

# JWT Authentication
# 256-bit hexadecimal or Base64 secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AWS S3 Telemetry Data Lake Archival
STORAGE_S3_ENABLED=false
STORAGE_S3_BUCKET=droneiq-telemetry-data-lake
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BATCH_SIZE=50
STORAGE_S3_FLUSH_INTERVAL_MS=10000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mock Telemetry Simulator Configuration
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_MS=1000
